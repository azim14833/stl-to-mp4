{
  "id": "./",
  "name": "STL to MP4 – 3D model video & views",
  "short_name": "STL→MP4",
  "description": "STL, 3MF ve OBJ modellerini tarayıcıda MP4 videoya ve görünüm resimlerine çevirir.",
  "lang": "tr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#e3e8ef",
  "theme_color": "#3b5bfd",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon-monochrome-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "monochrome"
    }
  ],
  "categories": [
    "utilities",
    "productivity",
    "graphics"
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "models",
          "accept": [
            ".stl",
            ".3mf",
            ".obj",
            ".ply",
            ".mtl",
            "model/stl",
            "model/3mf",
            "model/obj",
            "application/sla",
            "application/octet-stream"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/octet-stream": [
          ".stl",
          ".3mf",
          ".obj",
          ".ply"
        ],
        "model/stl": [
          ".stl"
        ],
        "model/3mf": [
          ".3mf"
        ],
        "model/obj": [
          ".obj"
        ]
      }
    }
  ]
}